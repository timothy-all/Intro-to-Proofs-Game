#. §0: `⋂₀`
#. §1: $$
#. ⋂₀ F = ⋂_{t ∈ F} t
#. $$
#. §2: `mem_finter_iff`
#. §3: `x ∈ ⋂₀ F ↔ ∀ (t : Set u), t ∈ F → x ∈ t`
#. §4: ```
#. mem_finter_iff
#.   {u : Type*}
#.   {x : u}
#.   (F : Set (Set u)) :
#.   x ∈ ⋂₀ F ↔ ∀ (t : Set u), t ∈ F → x ∈ t
#. ```
#: Game.Levels.SetWorld.set_docs
#: Game.Levels.SetWorld.set_docs
