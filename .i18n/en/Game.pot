#. §0: $$ P ∨ T₀ ↔ T₀ $$
#. §1: $T₀$
#. §2: $$
#. \\begin{array}{|cc||c|}
#.   \\hline
#.   P & T₀ & P ∨ T₀ \\
#.   \\hline
#.   T & T & T \\
#.   F & T & T \\
#.   \\hline
#. \\end{array}
#. $$
#: Game.Levels.EquivWorld.EquivWorld_eg.equiv_eg_docs
